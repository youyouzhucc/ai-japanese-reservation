# AI 日语电话预约系统 - 环境变量示例
# 复制为 .env 并填写实际配置

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./reservations.db

# 支付（模拟模式留空即可）
PAYMENT_MODE=mock
# STRIPE_SECRET_KEY=sk_xxx  # 若使用 Stripe

# Twilio - AI 电话 & 短信（需注册 https://www.twilio.com）
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890

# OpenAI - AI 对话（可选，用于生成日语话术）
# OPENAI_API_KEY=sk-xxx

# 阿里云短信（国内可选）
# ALIYUN_ACCESS_KEY=xxx
# ALIYUN_ACCESS_SECRET=xxx
# ALIYUN_SMS_SIGN_NAME=xxx
# ALIYUN_SMS_TEMPLATE_CODE=xxx
