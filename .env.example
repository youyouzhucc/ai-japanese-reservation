# AI 日语电话预约系统 - 环境变量示例
# 复制为 .env 并填写实际配置

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./reservations.db

# 支付（mock=模拟，alipay=支付宝当面付）
PAYMENT_MODE=mock

# 支付宝当面付（PAYMENT_MODE=alipay 时启用）
# ALIPAY_APP_ID=2021001234567890
# ALIPAY_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# ALIPAY_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
# ALIPAY_NOTIFY_URL=https://你的域名/api/alipay/notify
# ALIPAY_SANDBOX=false

# ---- AI 电话方案（二选一）----

# 方案1（推荐）：Vapi.ai - AI 电话一站式方案
# 注册 https://dashboard.vapi.ai 获取 API Key
VAPI_API_KEY=
# 在 Vapi 控制台 Phone Numbers 页面购买/导入号码后，复制号码 ID
VAPI_PHONE_NUMBER_ID=

# 方案2：Twilio + OpenAI（需分别注册两个服务）
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_PHONE_NUMBER=+1234567890
# OPENAI_API_KEY=sk-xxx

# 公网访问地址（用于 Vapi/Twilio 回调，未设置时从 QIUFK_NOTIFY_URL 推导）
# APP_BASE_URL=https://你的域名.up.railway.app

# 餐厅搜索（可选，配置后返回真实餐厅数据）
# 推荐 Foursquare：每月 $200 免费额度，无需绑卡，在 https://foursquare.com/developers/ 注册获取
# FOURSQUARE_API_KEY=fsq3xxx...
# Google Places：需启用 Places API，按量计费
# GOOGLE_PLACES_API_KEY=AIza...

# 登录认证（生产环境务必修改 jwt_secret）
# JWT_SECRET=your-random-secret-key
# JWT_EXPIRE_HOURS=168

# 阿里云短信（国内）- 融合认证套餐包
# 详见 docs/融合认证套餐包配置步骤.md
# ALIYUN_SMS_MODE=dypnsapi
# ALIYUN_ACCESS_KEY=你的AccessKey ID
# ALIYUN_ACCESS_SECRET=你的AccessKey Secret
# ALIYUN_SMS_SIGN_NAME=速通互联验证码
# ALIYUN_SMS_VERIFY_TEMPLATE_CODE=100001
# ALIYUN_PNVS_INSTANCE_ID=dypns_omniVerifySolution_public_cn-xxx
